{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm --prefix station-twin ci",
  "buildCommand": "npm --prefix station-twin run build -- --outDir ../dist --emptyOutDir && npm run build -- --base /national/ --outDir dist/national --emptyOutDir",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/station-twin", "destination": "/", "permanent": false },
    { "source": "/station-twin/", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/national", "destination": "/national/index.html" },
    { "source": "/national/", "destination": "/national/index.html" },
    { "source": "/national/api/:path*", "destination": "/api/:path*" }
  ]
}
